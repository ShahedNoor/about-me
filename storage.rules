rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Public Media: Anyone can view images/media, only Shahed can upload/edit/delete
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
                      request.auth.token.email == 'shahednoor32@gmail.com' &&
                      request.auth.token.email_verified == true;
    }
  }
}
