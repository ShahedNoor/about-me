rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public Portfolio Data: Anyone can read, only Shahed can write/edit/delete
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
                      request.auth.token.email == 'shahednoor32@gmail.com' &&
                      request.auth.token.email_verified == true;
    }
  }
}
